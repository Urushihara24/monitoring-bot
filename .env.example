# Telegram Bot (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789

# GGSEL API
# API key or JWT access token
GGSEL_API_KEY=your_api_key_here
# If GGSEL_API_KEY is a JWT, configure a separate secret for /apilogin:
GGSEL_API_SECRET=
# Optional: pre-issued access token when you want to set it manually
GGSEL_ACCESS_TOKEN=
GGSEL_SELLER_ID=8175
GGSEL_PRODUCT_ID=your_product_id_here
GGSEL_LANG=ru-RU
# true = refuse startup when the API is unavailable at launch
GGSEL_REQUIRE_API_ON_START=false
GGSEL_ENABLED=true
# GGSEL competitors; if empty, fall back to shared COMPETITOR_URLS
GGSEL_COMPETITOR_URLS=
# Automatic order-chat instructions (GGSEL)
GGSEL_CHAT_AUTOREPLY_ENABLED=false
# Comma-separated product_id list; if empty, GGSEL_PRODUCT_ID is used
GGSEL_CHAT_AUTOREPLY_PRODUCT_IDS=
GGSEL_CHAT_AUTOREPLY_PAGE_SIZE=50
GGSEL_CHAT_AUTOREPLY_MAX_PAGES=2
GGSEL_CHAT_AUTOREPLY_INTERVAL_SECONDS=30
GGSEL_CHAT_AUTOREPLY_DEDUPE_BY_MESSAGES=true
# true = send instructions only when the order chat is empty
GGSEL_CHAT_AUTOREPLY_ONLY_EMPTY_CHAT=true
# true = when the chat is not empty, allow sending after a simple trigger
# message (greeting/question about adding), but block when signs of a
# completed order are detected.
GGSEL_CHAT_AUTOREPLY_SMART_NON_EMPTY=false
# true = require a matching product-option rule; otherwise skip + log
GGSEL_CHAT_AUTOREPLY_REQUIRE_RULES=true
# false = disallow custom rule text and use only the product-option instruction
GGSEL_CHAT_AUTOREPLY_ALLOW_CUSTOM_TEXT=true
# false = disable template fallback text
GGSEL_CHAT_AUTOREPLY_ALLOW_TEMPLATE_FALLBACK=true
# Sending policy: ON_ORDER | FIRST_BUYER_MESSAGE | CODE_ONLY
GGSEL_CHAT_AUTOREPLY_POLICY=ON_ORDER
GGSEL_CHAT_AUTOREPLY_LOOKBACK_MESSAGES=30
GGSEL_CHAT_AUTOREPLY_RECENT_LOOKBACK_MINUTES=20
GGSEL_CHAT_AUTOREPLY_ENABLE_RECENT_FALLBACK=false
GGSEL_CHAT_AUTOREPLY_SENT_TTL_DAYS=30
GGSEL_CHAT_AUTOREPLY_CLEANUP_EVERY_HOURS=24
# Optional templates; when empty, use info/add_info from the product card
GGSEL_CHAT_TEMPLATE_RU_ALREADY=
GGSEL_CHAT_TEMPLATE_RU_ADD=
GGSEL_CHAT_TEMPLATE_EN_ALREADY=
GGSEL_CHAT_TEMPLATE_EN_ADD=

# DigiSeller API (second profile)
DIGISELLER_ENABLED=false
DIGISELLER_API_KEY=
DIGISELLER_API_SECRET=
DIGISELLER_ACCESS_TOKEN=
DIGISELLER_SELLER_ID=
DIGISELLER_PRODUCT_ID=
DIGISELLER_BASE_URL=https://api.digiseller.com/api
DIGISELLER_LANG=ru-RU
DIGISELLER_REQUIRE_API_ON_START=false
DIGISELLER_COMPETITOR_URLS=
# Automatic order-chat instructions (DigiSeller)
DIGISELLER_CHAT_AUTOREPLY_ENABLED=false
# Comma-separated product_id list; if empty, DIGISELLER_PRODUCT_ID is used
DIGISELLER_CHAT_AUTOREPLY_PRODUCT_IDS=
DIGISELLER_CHAT_AUTOREPLY_PAGE_SIZE=50
DIGISELLER_CHAT_AUTOREPLY_MAX_PAGES=2
DIGISELLER_CHAT_AUTOREPLY_INTERVAL_SECONDS=30
DIGISELLER_CHAT_AUTOREPLY_DEDUPE_BY_MESSAGES=true
# true = send instructions only when the order chat is empty
DIGISELLER_CHAT_AUTOREPLY_ONLY_EMPTY_CHAT=true
# true = when the chat is not empty, allow sending after a simple trigger
# message (greeting/question about adding), but block when signs of a
# completed order are detected.
DIGISELLER_CHAT_AUTOREPLY_SMART_NON_EMPTY=false
# true = require a matching product-option rule; otherwise skip + log
DIGISELLER_CHAT_AUTOREPLY_REQUIRE_RULES=true
# false = disallow custom rule text and use only the product-option instruction
DIGISELLER_CHAT_AUTOREPLY_ALLOW_CUSTOM_TEXT=true
# false = disable template fallback text
DIGISELLER_CHAT_AUTOREPLY_ALLOW_TEMPLATE_FALLBACK=true
# Sending policy: ON_ORDER | FIRST_BUYER_MESSAGE | CODE_ONLY
DIGISELLER_CHAT_AUTOREPLY_POLICY=ON_ORDER
DIGISELLER_CHAT_AUTOREPLY_LOOKBACK_MESSAGES=30
DIGISELLER_CHAT_AUTOREPLY_RECENT_LOOKBACK_MINUTES=20
DIGISELLER_CHAT_AUTOREPLY_ENABLE_RECENT_FALLBACK=true
DIGISELLER_CHAT_AUTOREPLY_SENT_TTL_DAYS=30
DIGISELLER_CHAT_AUTOREPLY_CLEANUP_EVERY_HOURS=24
# Optional templates; when empty, use info/add_info from the product card
DIGISELLER_CHAT_TEMPLATE_RU_ALREADY=
DIGISELLER_CHAT_TEMPLATE_RU_ADD=
DIGISELLER_CHAT_TEMPLATE_EN_ALREADY=
DIGISELLER_CHAT_TEMPLATE_EN_ADD=
# Optional DigiSeller profile-specific runtime defaults
# Applied on first launch only when the key is absent from runtime_settings:
DIGISELLER_MIN_PRICE=
DIGISELLER_MAX_PRICE=
DIGISELLER_DESIRED_PRICE=
DIGISELLER_UNDERCUT_VALUE=
DIGISELLER_MODE=
DIGISELLER_WEAK_PRICE_CEIL_LIMIT=
DIGISELLER_POSITION_FILTER_ENABLED=
DIGISELLER_WEAK_POSITION_THRESHOLD=
DIGISELLER_WEAK_UNKNOWN_RANK_ENABLED=
DIGISELLER_WEAK_UNKNOWN_RANK_ABS_GAP=
DIGISELLER_WEAK_UNKNOWN_RANK_REL_GAP=
DIGISELLER_CHECK_INTERVAL=
DIGISELLER_FAST_CHECK_INTERVAL_MIN=
DIGISELLER_FAST_CHECK_INTERVAL_MAX=
DIGISELLER_COOLDOWN_SECONDS=
DIGISELLER_IGNORE_DELTA=
DIGISELLER_NOTIFY_SKIP=
DIGISELLER_NOTIFY_SKIP_COOLDOWN_SECONDS=
DIGISELLER_NOTIFY_COMPETITOR_CHANGE=
DIGISELLER_COMPETITOR_CHANGE_DELTA=
DIGISELLER_COMPETITOR_CHANGE_COOLDOWN_SECONDS=
DIGISELLER_UPDATE_ONLY_ON_COMPETITOR_CHANGE=
DIGISELLER_NOTIFY_PARSER_ISSUES=
DIGISELLER_PARSER_ISSUE_COOLDOWN_SECONDS=
DIGISELLER_HARD_FLOOR_ENABLED=
DIGISELLER_MAX_DOWN_STEP=
DIGISELLER_FAST_REBOUND_DELTA=
DIGISELLER_FAST_REBOUND_BYPASS_COOLDOWN=

# Competitor URLs, comma-separated
COMPETITOR_URLS=https://ggsel.net/catalog/product/competitor-12345
# Cookies for protected pages (QRATOR/anti-bot)
# Format: name1=value1; name2=value2
# Profile-specific keys take priority over the shared value:
# GGSEL_COMPETITOR_COOKIES, DIGISELLER_COMPETITOR_COOKIES
GGSEL_COMPETITOR_COOKIES=
DIGISELLER_COMPETITOR_COOKIES=
COMPETITOR_COOKIES=
# Backup-cookie file path, alternative to COMPETITOR_COOKIES
COMPETITOR_COOKIES_BACKUP_PATH=data/cookies_backup.json
# Env-file path from which the scheduler reloads cookies into runtime state
# Defaults to ".env" in the process working directory
ENV_FILE_PATH=.env

# RSC parser (stealth_requests + bs4)
RSC_MAX_RETRIES=2

# Core pricing settings
MIN_PRICE=0.25
MAX_PRICE=10.0
DESIRED_PRICE=0.35
UNDERCUT_VALUE=0.0051

# Pricing mode:
# FOLLOW / DUMPING / RAISE
MODE=DUMPING

# Weak-position logic, enabled when POSITION_FILTER_ENABLED=true
WEAK_PRICE_CEIL_LIMIT=0.3
POSITION_FILTER_ENABLED=false
WEAK_POSITION_THRESHOLD=20
# Heuristic for a weak minimum-price competitor when rank=N/A:
WEAK_UNKNOWN_RANK_ENABLED=true
WEAK_UNKNOWN_RANK_ABS_GAP=0.03
WEAK_UNKNOWN_RANK_REL_GAP=0.08

# Cooldown in seconds: do not change price more frequently
COOLDOWN_SECONDS=30

# Ignore delta: do not update when the difference is smaller
IGNORE_DELTA=0.001

# Check interval in seconds
# Use 20..60 seconds for fast reaction
CHECK_INTERVAL=30
FAST_CHECK_INTERVAL_MIN=20
FAST_CHECK_INTERVAL_MAX=60

# Notifications
# NOTIFY_SKIP=false reduces Telegram noise; skips remain in logs/metrics
NOTIFY_SKIP=false
NOTIFY_SKIP_COOLDOWN_SECONDS=300
# Notify when the competitor minimum price changes, with anti-spam protection
NOTIFY_COMPETITOR_CHANGE=true
COMPETITOR_CHANGE_DELTA=0.0001
COMPETITOR_CHANGE_COOLDOWN_SECONDS=60
UPDATE_ONLY_ON_COMPETITOR_CHANGE=true
# General scheduler errors in Telegram; when false, server logs only
NOTIFY_ERRORS=true
NOTIFY_PARSER_ISSUES=true
PARSER_ISSUE_COOLDOWN_SECONDS=300

# Loss protection
HARD_FLOOR_ENABLED=true
MAX_DOWN_STEP=0.03
FAST_REBOUND_DELTA=0.01
FAST_REBOUND_BYPASS_COOLDOWN=true

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
